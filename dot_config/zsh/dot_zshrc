# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~~~~~~~~~~~~~~~~~~~

set -o vi
setopt NO_CLOBBER

export VISUAL=vim
export EDITOR=vim
export TERM="tmux-256color"

# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~~~~~


alias v=nvim
alias cl='clear'
alias zshrc='vim $ZDOTDIR/.zshrc'
alias zshrcs='source $ZDOTDIR/.zshrc'
alias cz='chezmoi'
alias lg='lazygit'
alias tkt='./scripts/run-docker.sh -m'

# ls
alias ls='ls --color=auto'
alias la='ls -lathr'
alias ll='ls -alF'
alias tl='tree -L'
alias l="eza -l --icons --git -a"
alias lt="eza --tree --level=2 --long --icons --git"
alias ltree="eza --tree --level=2  --icons --git"

# ~~~~~~~~~~~~~~~ Theme ~~~~~~~~~~~~~~~~~~~~~~~~
# Load Starship prompt
eval "$(starship init zsh)"

# ~~~~~~~~~~~~~~~ Autocompletion ~~~~~~~~~~~~~~~~~~~~~~~~

source "$XDG_CONFIG_HOME/chezmoi/chezmoi-completion.zsh"
compdef cz=chezmoi
