# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~~~~~~~~~~~~~~~~~~~

set -o vi
setopt NO_CLOBBER

export VISUAL=nvim
export EDITOR=nvim
export TERM="tmux-256color"

# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~~~~~

alias v=nvim
alias cl='clear'
alias zshrc='v $ZDOTDIR/.zshrc'
alias zshrcs='source $ZDOTDIR/.zshrc'
alias cz='chezmoi'
alias lg='lazygit'
alias dps='docker ps'
alias di='docker image'
alias tmux='tmux -f $XDG_CONFIG_HOME/tmux/tmux.conf'


# ls
alias ls='eza --icons --group-directories-first'
alias ll='eza -lah --icons --group-directories-first'
alias la='eza -a --icons --group-directories-first'
alias lt="eza --tree --level=2 --icons --git"
alias wezcp="cp ~/.config/wezterm/wezterm.lua /mnt/c/Users/sptar/.wezterm.lua"
alias fd='fdfind'


# ~~~~~~~~~~~~~~~ Theme ~~~~~~~~~~~~~~~~~~~~~~~~
if [[ "${widgets[zle-keymap-select]#user:}" == "starship_zle-keymap-select" || \
      "${widgets[zle-keymap-select]#user:}" == "starship_zle-keymap-select-wrapped" ]]; then
    zle -N zle-keymap-select "";
fi

eval "$(starship init zsh)"

# ~~~~~~~~~~~~~~~ Autocompletion ~~~~~~~~~~~~~~~~~~~~~~~~

# Load completion system early, before any compdef calls.
autoload -Uz compinit
compinit

source "$XDG_CONFIG_HOME/chezmoi/chezmoi-completion.zsh"
compdef cz=chezmoi

for p in \
  "$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
  [ -f "$p" ] && source "$p" && break
done

for p in \
  "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"; do
  [ -f "$p" ] && source "$p" && break
done

bindkey '^b' autosuggest-accept   # Tab


# ~~~~~~~~~~~~~~~ ssh ~~~~~~~~~~~~~~~~~~~~~~~~
eval "$(ssh-agent -s)"


# ~~~~~~~~~~~~~~~ path ~~~~~~~~~~~~~~~~~~~~~~~~
export PATH=$PATH:/usr/local/go/bin
export PATH="/opt/nvim/bin:$PATH"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"


# Initialize pyenv if installed
if command -v pyenv > /dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
fi


# ~~~~~~~~~~~~~~~ venv wrapper ~~~~~~~~~~~~~~~~~~~~~~~~
export VENV_HOME="$HOME/.virtualenvs"
[[ -d $VENV_HOME ]] || mkdir $VENV_HOME

lsvenv() {
  ls -1 $VENV_HOME
}

venv() {
  if [ $# -eq 0 ]
    then
      echo "Please provide venv name"
    else
      source "$VENV_HOME/$1/bin/activate"
  fi
}

mkvenv() {
  if [ $# -eq 0 ]
    then
      echo "Please provide venv name"
    else
      python3 -m venv $VENV_HOME/$1
  fi
}

rmvenv() {
  if [ $# -eq 0 ]
    then
      echo "Please provide venv name"
    else
      rm -r $VENV_HOME/$1
  fi
}


# ~~~~~~~~~~~~~~~ color ~~~~~~~~~~~~~~~~~~~~~~~~
# This is necessary for alacritty
export TERM=xterm-256color


# ~~~~~~~~~~~~~~~ zoxide ~~~~~~~~~~~~~~~~~~~~~~~~
eval "$(zoxide init zsh)"


# ~~~~~~~~~~~~~~~ yazi ~~~~~~~~~~~~~~~~~~~~~~~~
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}


